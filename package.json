{
  "name": "ayomatch",
  "version": "0.2.0",
  "private": true,
  "description": "AyoMatch - aplikasi Android (React Native/Expo) untuk matching mahasiswa: Study Match, Competition Match, Match Map berbasis Wi-Fi kampus, dan Event luar kampus yang dikurasi. Dibuat untuk Hackathon JOINTS UGM 2026.",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "build:apk": "eas build --platform android --profile preview",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-router": "~57.0.23",
    "expo-dev-client": "~57.0.19",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-font": "~57.0.4",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-svg": "15.15.4",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-url-polyfill": "4.0.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "zustand": "5.0.15",
    "react-hook-form": "7.89.0",
    "@hookform/resolvers": "5.9.1",
    "zod": "4.6.5",
    "date-fns": "4.4.0",
    "nativewind": "4.2.7",
    "lucide-react-native": "1.48.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.2.2",
    "tailwindcss": "3.4.19",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "@testing-library/react-native": "14.0.1",
    "eslint-config-expo": "57.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "eslint": "^9.39.0",
    "@react-native/jest-preset": "^0.86.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
