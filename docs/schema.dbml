// AyokMatch — draft skema database (DBML) untuk review ERD.
// Sumber: docs/ARCHITECTURE.md §5, docs/PRD.md §6–9, docs/METHODOLOGY.md.
// Cara lihat ERD: tempel seluruh isi file ini ke https://dbdiagram.io/d
//
// Catatan:
// - DBML hanya menggambarkan tabel & relasi. Policy RLS, trigger kuota, fungsi
//   (submit_personality_quiz, host_leave_session, recommend_study_partners), pg_cron,
//   dan bucket Storage ditulis di migration SQL di supabase/migrations/ (lihat ARCHITECTURE §4 & §6).
// - Tabel auth.users milik Supabase Auth; di sini hanya jadi referensi.
// - Tidak ada kolom BSSID/IP/koordinat pengguna di mana pun (presence hanya menyimpan zone_id).

Project ayokmatch {
  database_type: 'PostgreSQL'
  Note: 'AyokMatch — Study Match, Competition Match, Match Map, Event. Kampus pilot BINUS @Kemanggisan.'
}

// ───────────────────────── Enum ─────────────────────────

Enum user_role {
  student
  curator
  admin
}

Enum archetype {
  wildheart
  heartkeeper
  mindsmith
  groundbreaker
  kindled_flame
  sagekeeper
}

Enum zone_level {
  building
  room
}

Enum session_kind {
  belajar_kelompok [note: 'Belajar kelompok']
  tutor_sebaya     [note: 'Tutor sebaya']
  diskusi          [note: 'Diskusi']
}

Enum session_status {
  open
  cancelled
  done
}

Enum host_exit_action {
  transfer [note: 'Polling calon host']
  cancel   [note: 'Voting batalkan sesi (setuju >= 80%)']
}

Enum host_exit_result {
  pending
  passed
  failed
  na [note: 'Host sendirian, langsung batal']
}

Enum opening_status {
  open
  full
  closed
}

Enum join_request_status {
  requested
  accepted
  rejected
}

Enum venue_type {
  public
  partner
}

Enum venue_status {
  pending
  approved
}

Enum event_kind {
  monthly
  hobby
  partner
  small_table [note: 'Meja Kecil (Could-have)']
}

Enum event_status {
  draft
  published
  cancelled
}

Enum rsvp_status {
  going
  cancelled
}

Enum friendship_status {
  pending
  accepted
  blocked
}

Enum report_status {
  pending_review
  valid
  dismissed
}

// ───────────────────────── Identitas & profil ─────────────────────────

Table profiles {
  id uuid [pk, note: 'FK ke auth.users.id (1:1)']
  full_name text [not null]
  campus_email text [not null, unique, note: 'Harus @binus.ac.id (Auth Hook)']
  major text [note: 'Nama jurusan versi BINUS, contoh: Computer Science']
  semester smallint
  role user_role [not null, default: 'student']
  avatar_url text
  ktm_url text [note: 'Bucket privat, diakses lewat signed URL']
  show_on_map boolean [not null, default: false, note: 'Toggle Tampil di peta']
  personality_type archetype [note: 'Terkunci setelah submit akhir kuis']
  personality_scores jsonb [note: 'Persentase 6 archetype. Terkunci setelah submit akhir']
  personality_quiz_completed_at timestamptz [note: 'null = kuis belum final. Terisi = jawaban & hasil terkunci permanen']
  created_at timestamptz [not null, default: `now()`]

  Note: '1:1 dengan auth.users. Kolom personality_* hanya ditulis fungsi submit_personality_quiz (security definer). learning_style tidak dipakai di MVP.'
}

Table trusted_devices {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  device_id_hash text [not null]
  verified_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz

  indexes {
    (user_id, device_id_hash) [unique]
  }

  Note: 'HP yang sudah lolos OTP. HP lain wajib OTP saat masuk. RLS: hanya pemilik.'
}

Table personality_answers {
  profile_id uuid [not null]
  question_id text [not null, note: 'q1 s.d. q15']
  answer char(1) [not null, note: "'A' atau 'B'"]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (profile_id, question_id) [pk]
  }

  Note: 'Upsert bebas selama profiles.personality_quiz_completed_at null (draft). Terkunci permanen sesudahnya (RLS + trigger).'
}

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
  name text [not null]

  Note: 'Seed manual untuk MVP.'
}

// ───────────────────────── Zona & Match Map ─────────────────────────

Table campus_zones {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  parent_zone_id uuid [note: 'building -> room']
  level zone_level [not null]
  map_x numeric
  map_y numeric
  map_w numeric
  map_h numeric

  Note: 'Posisi pada peta skematis (react-native-svg), BUKAN koordinat GPS.'
}

Table wifi_access_points {
  bssid text [pk, note: 'Huruf kecil. Data infrastruktur, bukan data pengguna']
  zone_id uuid [not null]
  label text
  registered_by uuid
  created_at timestamptz [not null, default: `now()`]

  Note: 'Hanya admin yang insert/update. Dibaca Edge Function, tidak oleh klien biasa.'
}

Table presence {
  user_id uuid [pk]
  zone_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'now() + 15 menit; dibersihkan pg_cron tiap menit']

  Note: 'Satu baris per pengguna. Tanpa BSSID/IP/koordinat. RLS: visibilitas timbal balik. Zona berisi 1 orang: hanya jumlah yang tampil, identitas disembunyikan (view/fungsi security definer, bukan baca tabel langsung).'
}

// ───────────────────────── Match › Belajar ─────────────────────────

Table study_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  host_id uuid [note: 'null = sesi tanpa host, terkunci']
  course_id uuid [not null]
  title text [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  zone_id uuid [not null]
  session_kind session_kind [not null]
  capacity smallint [not null]
  agenda jsonb [note: '[{time, activity}]']
  bring_note text
  status session_status [not null, default: 'open']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Kuota dijaga trigger before insert di study_session_members (kunci baris sesi).'
}

Table study_session_members {
  session_id uuid [not null]
  user_id uuid [not null]
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, user_id) [pk]
  }

  Note: 'Tanpa status waitlist. Host juga tercatat di sini selama masih menjabat.'
}

Table study_session_materials {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  uploaded_by uuid [not null]
  file_path text [not null, note: 'Bucket privat session-materials: <session_id>/<nama-file>']
  file_name text [not null]
  mime_type text [not null]
  size_bytes integer [not null, note: 'Maks 10 MB per file, maks 5 file per sesi']
  created_at timestamptz [not null, default: `now()`]
}

Table session_host_exits {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  host_id uuid [not null, note: 'Host yang keluar']
  reason text [not null, note: 'Wajib, tidak boleh kosong']
  action host_exit_action [not null]
  new_host_id uuid [note: 'Hasil polling (action = transfer)']
  eligible_voters smallint [not null, note: 'Peserta selain host saat diajukan']
  required_votes smallint [note: 'ceil(0.8 * eligible_voters), khusus cancel']
  vote_deadline timestamptz [note: 'now() + 1 jam']
  result host_exit_result [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Riwayat keluar host + wadah polling/voting. Hanya bisa dibaca anggota sesi itu.'
}

Table session_host_votes {
  exit_id uuid [not null]
  voter_id uuid [not null]
  candidate_id uuid [note: 'Untuk action = transfer']
  approve boolean [note: 'Untuk action = cancel']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (exit_id, voter_id) [pk]
  }

  Note: 'Satu suara per peserta; host lama tidak ikut memilih.'
}

// ───────────────────────── Match › Lomba ─────────────────────────

Table team_openings {
  id uuid [pk, default: `gen_random_uuid()`]
  host_id uuid [not null]
  competition_name text [not null]
  category text [not null]
  registration_deadline timestamptz [not null]
  team_size smallint [not null]
  current_members smallint [not null, default: 1]
  roles_needed text[] [not null]
  guidebook_url text
  description text
  status opening_status [not null, default: 'open']
  created_at timestamptz [not null, default: `now()`]
}

Table team_join_requests {
  opening_id uuid [not null]
  user_id uuid [not null]
  message text
  status join_request_status [not null, default: 'requested']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (opening_id, user_id) [pk]
  }

  Note: 'RLS: hanya pembuat lowongan yang boleh mengubah status.'
}

// ───────────────────────── Event (luar kampus) ─────────────────────────

Table venues {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  address text [not null]
  venue_type venue_type [not null]
  status venue_status [not null, default: 'pending', note: 'Hanya approved yang bisa dipakai event']
}

Table events {
  id uuid [pk, default: `gen_random_uuid()`]
  curator_id uuid [not null]
  event_kind event_kind [not null]
  title text [not null]
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz
  venue_id uuid [not null]
  capacity smallint [not null]
  cost_note text [note: 'Catatan saja, contoh "± Rp35.000, bayar di tempat". Tidak ada pembayaran di app']
  status event_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Insert/update hanya role curator/admin lewat Edge Function create-event.'
}

Table event_rsvps {
  event_id uuid [not null]
  user_id uuid [not null]
  status rsvp_status [not null, default: 'going']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, user_id) [pk]
  }

  Note: 'Trigger kuota mengunci baris event. Tanpa daftar tunggu.'
}

Table event_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  group_no smallint [not null]

  indexes {
    (event_id, group_no) [unique]
  }

  Note: 'Meja Kecil (Could-have).'
}

Table event_group_members {
  group_id uuid [not null]
  user_id uuid [not null]

  indexes {
    (group_id, user_id) [pk]
  }
}

Table reconnect_votes {
  event_id uuid [not null]
  voter_id uuid [not null]
  target_id uuid [not null]

  indexes {
    (event_id, voter_id, target_id) [pk]
  }

  Note: 'Could-have. Tidak pernah bisa dibaca target (RLS: hanya voter).'
}

// ───────────────────────── Sosial & moderasi ─────────────────────────

Table friendships {
  requester_id uuid [not null]
  addressee_id uuid [not null]
  status friendship_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (requester_id, addressee_id) [pk]
  }
}

Table conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
}

Table conversation_members {
  conversation_id uuid [not null]
  user_id uuid [not null]

  indexes {
    (conversation_id, user_id) [pk]
  }
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Realtime.'
}

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  reporter_id uuid [not null]
  target_user_id uuid
  target_event_id uuid
  target_session_id uuid [note: 'Dipakai untuk laporan host yang keluar (target_user_id = host)']
  reason text [not null]
  evidence_url text
  status report_status [not null, default: 'pending_review', note: 'banned hanya lewat tinjauan admin, tidak ada auto-ban']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Setidaknya satu dari target_user_id / target_event_id / target_session_id terisi (CHECK di migration).'
}

// ───────────────────────── Relasi ─────────────────────────

Ref: profiles.id < trusted_devices.user_id [delete: cascade]
Ref: profiles.id < personality_answers.profile_id [delete: cascade]
Ref: profiles.id - presence.user_id [delete: cascade]

Ref: campus_zones.parent_zone_id > campus_zones.id [delete: set null]
Ref: campus_zones.id < wifi_access_points.zone_id
Ref: profiles.id < wifi_access_points.registered_by [delete: set null]
Ref: campus_zones.id < presence.zone_id [delete: cascade]

Ref: profiles.id < study_sessions.host_id [delete: set null]
Ref: courses.id < study_sessions.course_id
Ref: campus_zones.id < study_sessions.zone_id
Ref: study_sessions.id < study_session_members.session_id [delete: cascade]
Ref: profiles.id < study_session_members.user_id [delete: cascade]
Ref: study_sessions.id < study_session_materials.session_id [delete: cascade]
Ref: profiles.id < study_session_materials.uploaded_by
Ref: study_sessions.id < session_host_exits.session_id [delete: cascade]
Ref: profiles.id < session_host_exits.host_id
Ref: profiles.id < session_host_exits.new_host_id [delete: set null]
Ref: session_host_exits.id < session_host_votes.exit_id [delete: cascade]
Ref: profiles.id < session_host_votes.voter_id [delete: cascade]
Ref: profiles.id < session_host_votes.candidate_id [delete: set null]

Ref: profiles.id < team_openings.host_id [delete: cascade]
Ref: team_openings.id < team_join_requests.opening_id [delete: cascade]
Ref: profiles.id < team_join_requests.user_id [delete: cascade]

Ref: profiles.id < events.curator_id
Ref: venues.id < events.venue_id
Ref: events.id < event_rsvps.event_id [delete: cascade]
Ref: profiles.id < event_rsvps.user_id [delete: cascade]
Ref: events.id < event_groups.event_id [delete: cascade]
Ref: event_groups.id < event_group_members.group_id [delete: cascade]
Ref: profiles.id < event_group_members.user_id [delete: cascade]
Ref: events.id < reconnect_votes.event_id [delete: cascade]
Ref: profiles.id < reconnect_votes.voter_id [delete: cascade]
Ref: profiles.id < reconnect_votes.target_id [delete: cascade]

Ref: profiles.id < friendships.requester_id [delete: cascade]
Ref: profiles.id < friendships.addressee_id [delete: cascade]
Ref: conversations.id < conversation_members.conversation_id [delete: cascade]
Ref: profiles.id < conversation_members.user_id [delete: cascade]
Ref: conversations.id < messages.conversation_id [delete: cascade]
Ref: profiles.id < messages.sender_id

Ref: profiles.id < reports.reporter_id
Ref: profiles.id < reports.target_user_id [delete: set null]
Ref: events.id < reports.target_event_id [delete: set null]
Ref: study_sessions.id < reports.target_session_id [delete: set null]
