# Template environment AyokMatch. Salin ke .env lalu isi nilainya:
#   Copy-Item .env.example .env
#
# PERINGATAN KEAMANAN (aturan non-negotiable, lihat CLAUDE.md & ARCHITECTURE.md §6):
# Semua variabel EXPO_PUBLIC_* ikut terbundel ke dalam APK dan bisa dibaca siapa pun
# yang memegang file APK. JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY (atau secret
# server lain) di file ini maupun di .env. Service role key hanya diset sebagai secret
# Edge Function lewat `supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>`.

# Project URL Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=

# anon public key Supabase — aman di aplikasi karena dijaga RLS (BUKAN service_role key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Domain email kampus yang di-allowlist untuk login. Kampus pilot: binus.ac.id
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=
